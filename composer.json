{
    "name": "darvis/livewire-injection-stopper",
    "description": "Laravel middleware package to block spam robots and injection attempts, with Livewire security audit tools",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "livewire",
        "security",
        "middleware",
        "spam-protection",
        "injection-protection",
        "security-audit"
    ],
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.5",
        "livewire/livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Darvis\\LivewireInjectionStopper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\LivewireInjectionStopper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\LivewireInjectionStopper\\LivewireInjectionStopperServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}