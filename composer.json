{
    "name": "darvis/livewire-injection-stopper",
    "description": "Laravel middleware package to block spam robots and injection attempts, with Livewire security audit tools",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "livewire",
        "security",
        "middleware",
        "spam-protection",
        "injection-protection",
        "security-audit"
    ],
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl",
            "homepage": "https://arvid.nl"
        }
    ],
    "homepage": "https://github.com/ArvidDeJong/livewire-injection-stopper",
    "support": {
        "issues": "https://github.com/ArvidDeJong/livewire-injection-stopper/issues",
        "source": "https://github.com/ArvidDeJong/livewire-injection-stopper"
    },
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "livewire/livewire": "^3.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Darvis\\LivewireInjectionStopper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\LivewireInjectionStopper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "test:parallel": "vendor/bin/pest --parallel",
        "quality": [
            "@format",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\LivewireInjectionStopper\\LivewireInjectionStopperServiceProvider"
            ],
            "aliases": {
                "LivewireInjectionStopper": "Darvis\\LivewireInjectionStopper\\Facades\\LivewireInjectionStopper"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
