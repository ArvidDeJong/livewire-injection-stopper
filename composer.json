{
    "name": "darvis/livewire-injection-stopper",
    "description": "Blocks spam bots and Livewire payload injection in Laravel apps, keeps the resulting Livewire exceptions out of Sentry, and audits Livewire components for unlocked public properties.",
    "keywords": [
        "laravel",
        "livewire",
        "security",
        "middleware",
        "spam-protection",
        "injection-protection",
        "security-audit",
        "laravel-boost"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://arviddejong.github.io/livewire-injection-stopper/",
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/livewire-injection-stopper/issues",
        "source": "https://github.com/ArvidDeJong/livewire-injection-stopper"
    },
    "autoload": {
        "psr-4": {
            "Darvis\\LivewireInjectionStopper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\LivewireInjectionStopper\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\LivewireInjectionStopper\\LivewireInjectionStopperServiceProvider"
            ],
            "aliases": {
                "LivewireInjectionStopper": "Darvis\\LivewireInjectionStopper\\Facades\\LivewireInjectionStopper"
            }
        }
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "scripts": {
        "test": "pest tests",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
